# Confluence Configuration
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your_api_token
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY

# PostgreSQL/PGVector Configuration
POSTGRES_DB=confluence_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# OpenSearch Configuration
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_NAME=confluence_idx

# LLM Configuration
# For local Mistral with Ollama, this will typically be the container name
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=mistral

# Hybrid Search Configuration
# Alpha (α): Weight for keyword search results (e.g., 0.6)
HYBRID_SEARCH_ALPHA=0.6
# Beta (β): Weight for vector search results (e.g., 0.4)
HYBRID_SEARCH_BETA=0.4
# Score threshold to filter final results
HYBRID_SEARCH_THRESHOLD=0.4
# Top-k results to use for generation
TOP_K=5
